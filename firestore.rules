rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Test connection doc (used to verify client Firestore connection)
    match /test/{docId} {
      allow get: if true;
    }

    // Community Leaderboard (Public read, authenticated owner write)
    match /leaderboard/{userId} {
      allow get, list: if true;
      allow create: if isOwner(userId) && isValidId(userId)
        && incoming().userId == request.auth.uid
        && incoming().displayName is string
        && incoming().displayName.size() > 0
        && incoming().displayName.size() <= 120
        && incoming().totalFocusMinutes is number
        && incoming().totalFocusMinutes >= 0
        && incoming().completedSessions is number
        && incoming().completedSessions >= 0
        && incoming().currentStreak is number
        && incoming().currentStreak >= 0
        && incoming().habitsCompletedCount is number
        && incoming().habitsCompletedCount >= 0;
      allow update: if isOwner(userId)
        && incoming().userId == existing().userId
        && incoming().displayName is string
        && incoming().displayName.size() > 0
        && incoming().displayName.size() <= 120
        && incoming().totalFocusMinutes is number
        && incoming().totalFocusMinutes >= 0
        && incoming().completedSessions is number
        && incoming().completedSessions >= 0;
      allow delete: if isOwner(userId);
    }

    // User Profile Documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId)
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId);

      // Habits Subcollection
      match /habits/{habitId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(habitId)
          && incoming().userId == request.auth.uid
          && incoming().title is string
          && incoming().title.size() > 0
          && incoming().title.size() <= 120
          && incoming().color is string
          && incoming().color.size() <= 30
          && incoming().targetPerDay is number
          && incoming().targetPerDay >= 1
          && incoming().targetPerDay <= 50;
        allow update: if isOwner(userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().title is string
          && incoming().title.size() > 0
          && incoming().title.size() <= 120;
        allow delete: if isOwner(userId);
      }

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId)
          && incoming().userId == request.auth.uid
          && incoming().title is string
          && incoming().title.size() > 0
          && incoming().title.size() <= 160
          && incoming().completed is bool
          && incoming().estimatedSessions is number
          && incoming().estimatedSessions >= 1;
        allow update: if isOwner(userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().title is string
          && incoming().title.size() > 0
          && incoming().title.size() <= 160;
        allow delete: if isOwner(userId);
      }

      // User Preferences Subcollection
      match /preferences/{prefDoc} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && incoming().userId == request.auth.uid;
        allow update: if isOwner(userId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
